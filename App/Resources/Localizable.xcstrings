    "“Pofu” Would Like to Access Screen Time" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Pofu” Ekran Süresi'ne Erişmek İstiyor"
          }
        }
      }
    },
    "Providing “Pofu” access to Screen Time may allow it to see your activity data, restrict content, and limit the usage of apps and websites." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Pofu” uygulamasına Ekran Süresi erişimi vermek; etkinlik verilerinizi görmesine, içeriği kısıtlamasına, uygulamaların ve web sitelerinin kullanımını sınırlamasına izin verebilir."
          }
        }
      }
    },
