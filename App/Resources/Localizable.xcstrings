        }
      }
    },
    "How long?" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne kadar?"
          }
        }
      }
    },
    "How passes work" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzinler nasıl işler"
          }
        }
      }
    },
    "I couldn't open %@. Is it still installed?" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ açamadım. Hâlâ yüklü mü?"
          }
        }
      }
    },
    "I couldn't save my last change. Free up some space?" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son değişikliği kaydedemedim. Biraz yer açar mısın?"
          }
        }
      }
    },
    "I'll do it later" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonra yaparım"
          }
        }
      }
    },
    "I'm a hamster who gets fluffier every time you pick real life over the feed." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akış yerine hayatı seçtiğin her an biraz daha kabaran bir hamsterım."
          }
        }
      }
    },
    "I'm not at any door yet. One minute to set me up?" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz hiçbir kapıda değilim. Beni bir dakikada kuralım mı?"
          }
        }
      }
    },
    "If I don't show up" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ben çıkmazsam"
          }
        }
      }
    },
    "in my cheeks" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "yanaklarımda"
          }
        }
      }
    },
    "Instagram" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instagram"
          }
        }
      }
    },
    "iPhone only lets me appear if you invite me in the Shortcuts app. Make one automation for each app you want me at." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone, beni ancak sen Kestirmeler'den davet edersen gösteriyor. Kapısında durmamı istediğin her uygulama için bir otomasyon yap."
          }
        }
      }
    },
    "It works. I last hopped in at %@." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışıyor. En son %@ saatinde araya girdim."
          }
        }
      }
    },
    "Just bored" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıkıldım"
          }
        }
      }
    },
    "Keep going" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devam et"
          }
        }
      }
    },
    "Lock your phone. I'll be here when you're back." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonu kilitle. Döndüğünde buradayım."
          }
        }
      }
    },
    "Look at you. I feel fluffier already." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bak sen şuna. Şimdiden kabardım."
          }
        }
      }
    },
    "Look something up" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir şeye bakacağım"
          }
        }
