    "Go reply. I'll keep it short for you." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git cevapla. Kısa tutarız."
          }
        }
      }
    },
    "Goal: half. You're at %@." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
