            "value" : "Tamam"
          }
        }
      }
    },
    "Each window costs 1 seed a minute. Every pass bought in the last 3 hours makes the next one a quarter pricier. From 23:00 to 06:00, prices double." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her dakika 1 çekirdek. Son 3 saatte aldığın her izin, sonrakini dörtte bir pahalılaştırır. 23.00 ile 06.00 arasında fiyatlar iki katı."
          }
        }
      }
    },
    "Emergency: open for %lld min, free" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acil durum: %lld dakikalığına aç, ücretsiz"
          }
        }
      }
    },
    "End and keep my seeds" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitir, çekirdeklerim kalsın"
