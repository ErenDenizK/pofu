        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdi bitirelim mi? %lld çekirdek senin."
          }
        }
      }
    },
    "Ending a pass early gives back every unused whole minute at the price you paid." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzni erken bitirirsen kullanmadığın her tam dakika, ödediğin fiyattan geri gelir."
          }
        }
      }
    },
    "Enjoy. See you in %lld min." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyfini çıkar. %lld dakika sonra görüşürüz."
          }
        }
      }
    },
    "Every reach is a fresh chance. The next one's ours." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her açma isteği yeni bir şans. Sıradaki bizim."
