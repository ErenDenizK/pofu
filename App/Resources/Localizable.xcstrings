    "Nom. My cheeks are full of good minutes." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hamm. Yanaklarım güzel dakikalarla doldu."
          }
        }
      }
