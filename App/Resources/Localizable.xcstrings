    "Check that the automation is on, that it says Run Immediately (not Run After Confirmation), and that the Hop in action has the same app as the trigger." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomasyonun açık olduğuna, Hemen Çalıştır'ın seçili olduğuna (Onaydan Sonra Çalıştır değil) ve Hop in eyleminde tetikleyicideki uygulamanın seçili olduğuna bak."
          }
        }
      }
    },
