      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selam, Pofu"
          }
        }
      }
    },
    "Honor system: I trust you. Lock your phone and come back when the timer is done." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güven sistemi: Sana güveniyorum. Telefonu kilitle, süre bitince gel."
