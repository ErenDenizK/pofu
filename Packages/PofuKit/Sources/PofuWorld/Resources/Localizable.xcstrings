    "visitor.letter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet-day letter"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessiz gün mektubu"
          }
        }
      }
    },
    "visitor.letter.hint": {
      "localizations": {
