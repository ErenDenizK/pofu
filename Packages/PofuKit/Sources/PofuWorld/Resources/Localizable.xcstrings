          "stringUnit": {
            "state": "translated",
            "value": "Choose who comes tomorrow"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarın kimin geleceğini seç"
          }
        }
      }
    },
    "invite.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who should we invite tomorrow?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarın kimi çağıralım?"
          }
        }
      }
    },
    "invite.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone you have met. It costs nothing and never runs out."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanıştığın biri olabilir. Hiçbir şey harcamaz, süresi dolmaz."
          }
        }
      }
    },
    "invite.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have not met anyone yet. Visitors will come."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kimseyle tanışmadın. Ziyaretçiler gelecek."
          }
        }
      }
    },
    "invite.close": {
      "localizations": {
