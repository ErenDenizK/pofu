[V:bed.pad] [D,A,F]8 | [A,,E,C]8 | [G,,D,B,]8 | [A,,E,A,]8 |
[V:bed.bass] D,,4 A,,4 | A,,4 E,,4 | G,,4 D,,4 | A,,8 |
[V:pulse.keys] D,2 A,2 D2 A,2 | A,,2 E,2 A,2 E,2 | B,,2 D,2 G,2 D,2 | A,,2 E,2 A,4 |
