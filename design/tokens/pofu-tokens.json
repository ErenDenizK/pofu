{
  "$schema-note": "Design source of truth for Pofu colors. Documented in docs/archive/design-language.md and docs/design/art-bible.md. Swift tokens in PofuDesignSystem are ported from this file by hand; tools/design/contrast_report.py and tools/assets/process_assets.py read it directly.",
  "version": "1.0.0",
  "primitives": {
    "cream-50": "#FFFBF5",
    "cream-100": "#FFF6EC",
    "cream-200": "#FBEBDD",
    "cream-300": "#F3DCC8",
    "peach-300": "#F4C7A4",
    "peach-400": "#ECA96E",
    "peach-600": "#D69069",
    "peach-800": "#8A4F2B",
    "blush-200": "#FDD9CF",
    "blush-400": "#FDC1B0",
    "blush-500": "#F6A290",
    "ink-900": "#2A1F2D",
    "ink-700": "#4A3B4A",
    "ink-600": "#66555F",
    "ink-400": "#8E7D88",
    "ink-300": "#A99AA3",
    "violet-100": "#EEE8FF",
    "violet-300": "#B9A2FF",
    "violet-500": "#8F74F0",
    "violet-600": "#6C4FD8",
    "violet-700": "#553BB8",
    "meadow-300": "#8FD4A4",
    "meadow-400": "#8CC084",
    "meadow-700": "#2F7349",
    "honey-300": "#F7C873",
    "honey-400": "#F5B83D",
    "honey-800": "#8A5A00",
    "rose-300": "#FF9EB5",
    "rose-700": "#B23A5A",
    "night-950": "#15111C",
    "night-900": "#1E1828",
    "night-800": "#2A2236",
    "night-700": "#3A3048",
    "mist-300": "#B8A8B1",
    "mist-500": "#85768A",
    "violet-night-200": "#2E2547",
    "white": "#FFFFFF"
  },
  "semantic": {
    "background.canvas": { "light": "cream-100", "dark": "night-950" },
    "background.sunken": { "light": "cream-200", "dark": "night-950" },
    "surface.card": { "light": "cream-50", "dark": "night-900" },
    "surface.raised": { "light": "white", "dark": "night-800" },
    "text.primary": { "light": "ink-900", "dark": "cream-100" },
    "text.secondary": { "light": "ink-600", "dark": "mist-300" },
    "text.tertiary": { "light": "ink-400", "dark": "mist-500" },
    "text.onAccent": { "light": "white", "dark": "night-950" },
    "accent": { "light": "violet-600", "dark": "violet-300" },
    "accent.pressed": { "light": "violet-700", "dark": "violet-500" },
    "accent.tint": { "light": "violet-100", "dark": "violet-night-200" },
    "success": { "light": "meadow-700", "dark": "meadow-300" },
    "warning": { "light": "honey-800", "dark": "honey-300" },
    "critical": { "light": "rose-700", "dark": "rose-300" },
    "energy.fill": { "light": "honey-400", "dark": "honey-400" },
    "energy.onFill": { "light": "ink-900", "dark": "ink-900" },
    "decor.blush": { "light": "blush-400", "dark": "blush-500" },
    "decor.peach": { "light": "peach-400", "dark": "peach-300" }
  },
  "contrastChecks": [
    { "fg": "text.primary", "bg": ["background.canvas", "background.sunken", "surface.card", "surface.raised"], "min": 4.5 },
    { "fg": "text.secondary", "bg": ["background.canvas", "background.sunken", "surface.card", "surface.raised"], "min": 4.5 },
    { "fg": "text.tertiary", "bg": ["background.canvas", "background.sunken", "surface.card"], "min": 3.0, "note": "Non-essential text only (placeholders, disabled); never body copy." },
    { "fg": "accent", "bg": ["background.canvas", "background.sunken", "surface.card", "surface.raised"], "min": 4.5, "note": "Accent is used as text (links, tinted buttons)." },
    { "fg": "text.onAccent", "bg": ["accent", "accent.pressed"], "min": 4.5 },
    { "fg": "accent", "bg": ["accent.tint"], "min": 4.5, "note": "Selected chip label on its tint." },
    { "fg": "success", "bg": ["background.canvas", "surface.card"], "min": 4.5 },
    { "fg": "warning", "bg": ["background.canvas", "surface.card"], "min": 4.5 },
    { "fg": "critical", "bg": ["background.canvas", "surface.card"], "min": 4.5 },
    { "fg": "energy.onFill", "bg": ["energy.fill"], "min": 4.5 },
    { "fg": "decor.blush", "bg": ["background.canvas"], "min": 1.0, "note": "Decorative only: never carries meaning or text." },
    { "fg": "decor.peach", "bg": ["background.canvas"], "min": 1.0, "note": "Decorative only: never carries meaning or text." }
  ],
  "artPalettes": {
    "$note": "Palette locks for AI-generated imagery (docs/design/art-bible.md). Sampled from the approved hamster concept (2026-10-31). The drift report measures each pixel's CIELAB distance to the nearest mix of two locked colors, so painted gradients between locked colors do not count as drift.",
    "character": {
      "fur-cream-light": "#FEF2E3",
      "fur-cream": "#FAE1CE",
      "fur-cream-shade": "#F4D3BD",
      "fur-peach-light": "#F4C7A4",
      "fur-peach": "#ECA96E",
      "fur-peach-deep": "#D69069",
      "fur-peach-shadow": "#B87650",
      "ear-inner": "#F6A290",
      "blush": "#FDC1B0",
      "nose": "#FD9B86",
      "paw": "#F0C4AE",
      "eye-iris": "#40251C",
      "eye-ink": "#241511",
      "highlight": "#FFFFFF",
      "plate-peach": "#FEEEE6"
    },
    "character-wilting": {
      "$note": "Wilting is the same hamster with chroma pulled down toward warm ash, never blue-gray, never green.",
      "ash-cream": "#EDE6DF",
      "ash-cream-shade": "#D9CEC5",
      "ash-peach": "#CDB8A6",
      "ash-peach-deep": "#B09C8E",
      "ash-blush": "#E3C3BA"
    },
    "world-day": {
      "sky-top": "#BFE1F0",
      "sky-haze": "#E6F2EE",
      "horizon-cream": "#FCEBDD",
      "meadow-light": "#CFE6B0",
      "meadow": "#A8D08D",
      "meadow-mid": "#8CC084",
      "meadow-deep": "#5E9E6A",
      "path-cream": "#F3DCC8",
      "flower-blush": "#FDC1B0",
      "flower-honey": "#F7C873",
      "flower-lilac": "#B9A2FF",
      "cloud": "#FFFFFF"
    },
    "world-sunset": {
      "sky-violet": "#8F74F0",
      "sky-mauve": "#C79BD8",
      "sky-coral": "#F2A38A",
      "horizon-gold": "#FFD3A1",
      "meadow-gold": "#C9C27E",
      "meadow-dusk": "#7E9A6B",
      "meadow-shadow": "#5B6E5A",
      "sun": "#FFE7B8"
    },
    "world-night": {
      "sky-deep": "#15111C",
      "sky": "#1E1828",
      "sky-indigo": "#2E2650",
      "sky-violet": "#3A3070",
      "moon": "#FFF1D6",
      "firefly": "#F7E08A",
      "meadow-night": "#2F4A45",
      "meadow-night-deep": "#1F302F",
      "window-glow": "#F5B83D"
    },
    "ui": {
      "cream-100": "#FFF6EC",
      "ink-900": "#2A1F2D",
      "violet-600": "#6C4FD8",
      "violet-300": "#B9A2FF",
      "honey-400": "#F5B83D",
      "meadow-700": "#2F7349"
    }
  }
}
