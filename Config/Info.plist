<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Keys that build settings cannot express. Xcode merges this file with the
  generated Info.plist (GENERATE_INFOPLIST_FILE). The schemes must match
  ProtectedApp.allQueriedSchemes in PofuCore; Pofu asks canOpenURL only for
  these, to hand the user back to the app after Hop!.
-->
<dict>
	<!--
	  The launch screen is a painted dawn sky (`launch-sky`, experience v1
	  section 3.5) over the LaunchBackground color (cream-100 by day,
	  night-950 in dark mode), so a cold launch never flashes white. The
	  in-app launch curtain carries on from the same sky.
	-->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>launch-sky</string>
	</dict>
	<!--
	  Lets views that ask for it (the island games' SKView, the world's
	  frame meter) run at 120 Hz on ProMotion iPhones. Everything else
	  keeps the system's default rate.
	-->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram</string>
		<string>youtube</string>
		<string>snssdk1233</string>
		<string>snssdk1180</string>
		<string>tiktok</string>
		<string>twitter</string>
		<string>x</string>
		<string>snapchat</string>
		<string>reddit</string>
		<string>fb</string>
	</array>
</dict>
</plist>
