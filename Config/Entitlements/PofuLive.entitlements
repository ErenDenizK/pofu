<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Used only by the PofuLive scheme (docs/development.md, "Membership day 1").
  A free Personal Team cannot sign Family Controls or App Groups, so the
  default Pofu scheme carries no entitlements at all.
-->
<dict>
	<key>com.apple.developer.family-controls</key>
	<true/>
	<!-- The "Open with Pofu" notification breaks through Focus (gate v2, 5.7). -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.erendenizk.pofu</string>
	</array>
</dict>
</plist>
